{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "https://pdnd-prod-dl-1-public-data.s3.eu-central-1.amazonaws.com/dashboard/send/dashboard-send-sezione2.json",
    "format": { "property": "enti_attivi" }
  },
  "params": [{ "name": "year", "value": null }],
  "transform": [
    { "filter": "year === year(datum.year) || year === datum.year" },
    { "filter": "datum.pct_variazione_vs_anno_prec !== null" }
  ],
  "mark": "text",
  "encoding": {
    "text": {
      "field": "pct_variazione_vs_anno_prec",
      "type": "quantitative",
      "format": ".0%"
    }
  }
}
