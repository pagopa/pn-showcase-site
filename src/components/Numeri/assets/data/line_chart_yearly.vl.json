{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": "container",
  "height": "container",
  "padding": 5,
  "data": {
    "url": "https://pdnd-prod-dl-1-public-data.s3.eu-central-1.amazonaws.com/dashboard/send/dashboard-send-sezione1.json",
    "format": {
      "property": "notifiche_per_mese"
    }
  },
  "params": [
    {
      "name": "notification_type",
      "value": "total"
    },
    {
      "name": "year",
      "value": null
    }
  ],
  "transform": [
    {
      "calculate": "datum['num_iun_' + notification_type]",
      "as": "notification_value"
    },
    {
      "calculate": "toString(year(datum.month))",
      "as": "year_val"
    },
    {
      "aggregate": [
        { "op": "sum", "field": "notification_value", "as": "annual_total" }
      ],
      "groupby": ["year_val"]
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "annual_total",
          "as": "cumulative"
        }
      ],
      "sort": [
        {
          "field": "year_val"
        }
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "total_records"
        }
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "area",
        "line": {
          "color": "#0B3EE3"
        },
        "color": {
          "x1": 1,
          "y1": 1,
          "x2": 1,
          "y2": 0,
          "stops": [
            {
              "offset": 0,
              "color": "white"
            },
            {
              "offset": 1,
              "color": "#0B3EE3"
            }
          ],
          "gradient": "linear"
        }
      },
      "encoding": {
        "y": {
          "field": "cumulative",
          "type": "quantitative",
          "axis": {
            "format": "~s",
            "labelFontWeight": 600,
            "labelFont": "Titillium Web, sans-serif",
            "domain": false
          }
        },
        "x": {
          "field": "year_val",
          "type": "ordinal",
          "sort": "ascending",
          "axis": {
            "grid": false,
            "labelFontWeight": 600,
            "labelFont": "Titillium Web, sans-serif",
            "labelAngle": 0,
            "title": null
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.total_records == 1"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 1,
        "fill": "#0B3EE3",
        "size": 100,
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "year_val",
          "type": "ordinal",
          "sort": "ascending"
        },
        "y": {
          "field": "cumulative",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "rect",
        "color": "transparent",
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "year_val",
          "type": "ordinal",
          "sort": "ascending"
        },
        "y": {
          "field": "cumulative",
          "type": "quantitative"
        },
        "y2": {
          "value": 0
        },
        "tooltip": [
          {
            "field": "year_val",
            "title": "Anno"
          },
          {
            "field": "cumulative",
            "title": "Notifiche cumulate",
            "format": ","
          },
          {
            "field": "annual_total",
            "title": "Notifiche annuali",
            "format": ","
          }
        ]
      }
    }
  ]
}
